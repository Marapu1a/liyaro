---
import Container from '../ui/Container.astro';

const steps = [
  {
    title: 'Вы рассказываете ситуацию',
    description: 'В свободной форме — так, как объяснили бы её знакомому.',
  },
  {
    title: 'Разбираемся вместе',
    description: 'Задаём вопросы и отделяем саму задачу от возможных решений.',
  },
  {
    title: 'Определяем следующий шаг',
    description: 'Иногда это разработка. Иногда сначала нужно проверить идею или изменить подход.',
  },
];
---

<section class="next-steps" aria-labelledby="next-steps-title">
  <Container>
    <div class="heading">
      <p class="section-label">Что будет дальше</p>
      <h2 id="next-steps-title">Сначала — обычный разговор</h2>
    </div>

    <ol>
      {
        steps.map((step, index) => (
          <li>
            <p class="number">0{index + 1}</p>
            <div>
              <h3>{step.title}</h3>
              <p class="description">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .next-steps {
    padding-block: var(--section-space);
  }

  .heading {
    display: grid;
    grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--section-space);
  }

  .section-label,
  .number {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ol {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  li {
    display: grid;
    grid-template-columns: minmax(4rem, 0.2fr) minmax(0, 1fr);
    gap: var(--space-lg);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--color-border);
  }

  li > div {
    display: grid;
    grid-template-columns: minmax(14rem, 0.65fr) minmax(18rem, 1fr);
    gap: var(--space-lg);
  }

  .description {
    max-width: 34rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 44rem) {
    .heading,
    li,
    li > div {
      grid-template-columns: 1fr;
    }

    .heading {
      margin-bottom: var(--space-lg);
    }

    li,
    li > div {
      gap: 1rem;
    }
  }
</style>
