---
import Container from '../ui/Container.astro';

const phases = [
  {
    kicker: '01 / Вместе',
    title: 'Понимаем цель',
    description: 'Что должно измениться — и зачем.',
    note: 'Контекст',
  },
  {
    kicker: '02 / Согласование',
    title: 'Фиксируем маршрут',
    description: 'Этапы, сроки и контрольные точки.',
    note: 'План подтверждён',
  },
  {
    kicker: '03 / Реализация',
    title: 'Делаем под ключ',
    description: 'Вы — на контрольных точках. Мы — во всей остальной работе.',
    note: 'Liyaro / Работа',
  },
];
---

<section class="next-steps" aria-labelledby="next-steps-title">
  <Container>
    <div class="heading" data-reveal>
      <p class="section-label">02 / Как строится работа</p>
      <h2 id="next-steps-title">Сначала согласуем маршрут. Дальше — работа под ключ.</h2>
    </div>

    <ol class="scroll-stack" data-scroll-stack>
      {
        phases.map((phase, index) => (
          <li
            class:list={{
              'scroll-stack-card': true,
              'scroll-stack-card--approved': index === 1,
              'scroll-stack-card--delivery': index === 2,
            }}
            data-scroll-stack-card
            style={`--stack-index: ${index}; --stack-z: ${index + 1};`}
          >
            <div class="card-meta">
              <p class="card-kicker">{phase.kicker}</p>
              <p class="card-note">{phase.note}</p>
            </div>
            <div class="card-copy">
              <h3>{phase.title}</h3>
              <p>{phase.description}</p>
            </div>
          </li>
        ))
      }
      <li class="scroll-stack-end" aria-hidden="true"></li>
    </ol>
  </Container>
</section>

<style>
  .next-steps {
    position: relative;
    padding-block: var(--section-space) 0;
  }

  .next-steps::before {
    position: absolute;
    top: 0;
    right: 5vw;
    width: clamp(7rem, 15vw, 13rem);
    height: 1px;
    background: var(--color-accent);
    content: '';
  }

  .heading {
    display: grid;
    grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1fr);
    gap: var(--space-lg);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-label,
  .card-kicker,
  .card-note {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .section-label {
    color: var(--color-text-muted);
  }

  h2 {
    max-width: 15ch;
  }

  .scroll-stack {
    position: relative;
    padding-bottom: 32vh;
    list-style: none;
  }

  .scroll-stack-card {
    --stack-scale: 1;
    position: sticky;
    z-index: var(--stack-z);
    top: calc(clamp(5.75rem, 12vh, 8.5rem) + var(--stack-index) * 1.35rem);
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: clamp(17rem, 38vh, 21rem);
    margin-bottom: clamp(7rem, 17vh, 11rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: 0 1.5rem 4rem rgb(18 19 17 / 0.08);
    transform: translateZ(0) scale(var(--stack-scale));
    transform-origin: top center;
    backface-visibility: hidden;
    will-change: transform;
  }

  .scroll-stack-card::before {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(18 19 17 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(18 19 17 / 0.06) 1px, transparent 1px);
    background-size: clamp(3rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
    content: '';
  }

  .scroll-stack-card--approved {
    border-color: rgb(213 79 45 / 0.42);
    background: var(--color-surface-raised);
  }

  .scroll-stack-card--delivery {
    color: var(--color-background);
    border-color: rgb(255 255 255 / 0.12);
    background: var(--color-dark);
    box-shadow: 0 1.75rem 5rem rgb(18 19 17 / 0.16);
  }

  .scroll-stack-card--delivery::before {
    opacity: 0.13;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.12) 1px, transparent 1px);
  }

  .card-meta,
  .card-copy {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .card-kicker {
    color: var(--color-accent);
  }

  .card-note {
    color: var(--color-text-muted);
  }

  .scroll-stack-card--delivery .card-note {
    color: rgb(243 240 232 / 0.48);
  }

  .card-copy {
    align-items: end;
    align-self: end;
  }

  .card-copy h3 {
    max-width: 10ch;
    font-size: clamp(2.1rem, 5vw, 4.6rem);
    font-weight: 580;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .scroll-stack-card--delivery h3 {
    font-weight: 650;
  }

  .card-copy p {
    max-width: 25rem;
    color: rgb(18 19 17 / 0.7);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 430;
    line-height: 1.45;
  }

  .scroll-stack-card--delivery .card-copy p {
    color: rgb(243 240 232 / 0.72);
  }

  .scroll-stack-end {
    height: 1px;
  }

  @media (max-width: 44rem) {
    .heading {
      grid-template-columns: 1fr;
      margin-bottom: 2.75rem;
    }

    h2 {
      max-width: 12ch;
    }

    .scroll-stack {
      padding-bottom: 22vh;
    }

    .scroll-stack-card {
      top: calc(5rem + var(--stack-index) * 0.85rem);
      min-height: 15.5rem;
      margin-bottom: 25vh;
      padding: 1.35rem;
    }

    .card-note {
      max-width: 9rem;
      text-align: right;
    }

    .card-copy {
      display: grid;
      gap: 1rem;
    }

    .card-copy h3 {
      max-width: 9ch;
      font-size: clamp(2.2rem, 12vw, 3.25rem);
    }

    .card-copy p {
      max-width: 19rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-stack-card {
      position: relative;
      top: auto;
      margin-bottom: 1rem;
      transform: none !important;
      will-change: auto;
    }

    :global(html.motion-enabled) .scroll-stack-card {
      position: sticky;
      top: calc(clamp(5.75rem, 12vh, 8.5rem) + var(--stack-index) * 1.35rem);
      margin-bottom: clamp(7rem, 17vh, 11rem);
      transform: translateZ(0) scale(var(--stack-scale)) !important;
      will-change: transform;
    }
  }

  @media (max-width: 44rem) and (prefers-reduced-motion: reduce) {
    :global(html.motion-enabled) .scroll-stack-card {
      top: calc(5rem + var(--stack-index) * 0.85rem);
      margin-bottom: 25vh;
    }
  }
</style>
