---
import Container from '../ui/Container.astro';

const tasks = [
  'Перенести аренду или бронирование с площадок в собственный сервис.',
  'Заменить таблицы и переписки общей системой.',
  'Создать личный кабинет для клиентов или сотрудников.',
  'Добавить оплату, документы, роли или реестры в существующий проект.',
  'Разработать отдельный модуль для продукта другой компании или студии.',
  'Проверить идею и определить состав первой рабочей версии.',
];
---

<section class="tasks" aria-labelledby="tasks-title">
  <Container>
    <div class="layout">
      <h2 id="tasks-title">С какими задачами можно прийти</h2>
      <ul>
        {tasks.map((task) => <li>{task}</li>)}
      </ul>
    </div>
  </Container>
</section>

<style>
  .tasks {
    padding-block: var(--section-space);
    background: var(--color-surface);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: var(--section-space);
    align-items: start;
  }

  ul {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  li {
    position: relative;
    padding: 1.25rem 0 1.25rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  li::before {
    position: absolute;
    top: 1.25rem;
    left: 0;
    content: '—';
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
