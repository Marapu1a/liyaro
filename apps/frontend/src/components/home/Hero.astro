---
import Container from '../ui/Container.astro';
import AmbientField from './AmbientField.astro';

const titleWords = ['Расскажите,', 'с', 'чем', 'пришли.'];
---

<section class="hero" aria-labelledby="hero-title">
  <AmbientField />
  <Container>
    <div class="hero-content">
      <h1 id="hero-title" aria-label="Расскажите, с чем пришли.">
        {titleWords.map((word, index) => <span aria-hidden="true" data-reveal style={`--reveal-delay: ${60 + index * 55}ms`}>{word}</span>)}
      </h1>
      <p class="lead" data-reveal style="--reveal-delay: 220ms">
        Упростить процесс, автоматизировать рутину, запустить новое или переделать старое —
        приходить с готовым ТЗ не обязательно.
      </p>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 5rem);
    padding-block: clamp(4.5rem, 10vw, 8rem) var(--section-space);
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 68rem;
  }

  h1 {
    max-width: 63rem;
  }

  h1 span {
    display: inline-block;
    margin-right: 0.18em;
  }

  .lead {
    max-width: 43rem;
    margin-left: min(18vw, 13rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.35;
  }

  @media (max-width: 36rem) {
    .lead {
      margin-left: 0;
    }
  }
</style>
