---
import { siteConfig } from '../../config/site';
import Container from '../ui/Container.astro';

const contactHref = `mailto:${siteConfig.contactEmail}`;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <Container>
    <div class="content">
      <h2 id="contact-title">Есть задача, но пока непонятно, как её решить?</h2>
      <div class="details">
        <p>
          Расскажите, как всё работает сейчас и что вы хотите изменить. Для первого разговора
          техническое задание не требуется.
        </p>
        <a href={contactHref}>Обсудить задачу <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </Container>
</section>

<style>
  .contact {
    padding-block: var(--section-space);
    color: var(--color-background);
    background: var(--color-text);
  }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: var(--section-space);
    align-items: end;
  }

  .details {
    max-width: 34rem;
  }

  .details p {
    color: #c9c6c0;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    margin-top: var(--space-lg);
    padding-block: 1rem;
    border-top: 1px solid #5b5a5d;
    border-bottom: 1px solid #5b5a5d;
    font-weight: 650;
    text-decoration: none;
  }

  a:focus-visible {
    outline-color: var(--color-background);
  }

  @media (max-width: 48rem) {
    .content {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
