---
import Container from '../ui/Container.astro';

const messages = [
  'Работаем уже несколько лет. Хочется уйти от Excel, но не понимаем, с чего начать.',
  'Есть идея сервиса. Пока вообще непонятно, стоит ли её делать.',
  'Хотим расширить бизнес. Кажется, без собственной системы уже не получится.',
  'Есть существующий проект. Нужно понять, дорабатывать его или проще сделать иначе.',
];
---

<section class="situations" aria-labelledby="situations-title">
  <Container>
    <div class="heading">
      <p class="section-label">Можно написать как есть</p>
      <h2 id="situations-title">Необязательно формулировать техническую задачу</h2>
    </div>

    <div class="messages">
      {messages.map((message) => <blockquote>{message}</blockquote>)}
    </div>
  </Container>
</section>

<style>
  .situations {
    padding-block: var(--section-space);
    background: var(--color-surface);
  }

  .heading {
    display: grid;
    grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--section-space);
  }

  .section-label {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .messages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-border);
  }

  blockquote {
    min-height: 13rem;
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  blockquote:nth-child(odd) {
    border-left: 1px solid var(--color-border);
  }

  @media (max-width: 44rem) {
    .heading,
    .messages {
      grid-template-columns: 1fr;
    }

    .heading {
      margin-bottom: var(--space-lg);
    }

    blockquote {
      min-height: auto;
      border-left: 1px solid var(--color-border);
    }
  }
</style>
