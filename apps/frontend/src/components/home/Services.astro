---
import Container from '../ui/Container.astro';

const services = [
  {
    title: 'Сайты и площадки',
    description:
      'Публичные сайты, каталоги, площадки и другие решения, через которые бизнес представляет свои услуги, получает обращения или работает с клиентами.',
  },
  {
    title: 'Сервисы и внутренние системы',
    description:
      'Личные кабинеты, реестры, системы заявок, документооборот, платежи и автоматизация внутренних процессов.',
  },
  {
    title: 'Доработка существующих проектов',
    description:
      'Разбор уже работающего проекта, добавление новых функций, исправление проблем и постепенное развитие без полной перестройки системы.',
  },
];
---

<section id="services" class="services" aria-labelledby="services-title">
  <Container>
    <div class="section-heading">
      <p>Что делаем</p>
      <h2 id="services-title">Решение зависит от задачи</h2>
    </div>

    <div class="service-list">
      {
        services.map((service, index) => (
          <article>
            <p class="number">0{index + 1}</p>
            <h3>{service.title}</h3>
            <p class="description">{service.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .services {
    padding-block: var(--section-space);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--section-space);
  }

  .section-heading > p,
  .number {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-list {
    border-top: 1px solid var(--color-border);
  }

  article {
    display: grid;
    grid-template-columns: minmax(4rem, 0.25fr) minmax(15rem, 0.75fr) minmax(18rem, 1fr);
    gap: var(--space-lg);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .description {
    max-width: 36rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .section-heading,
    article {
      grid-template-columns: 1fr;
    }

    .section-heading {
      margin-bottom: var(--space-lg);
    }

    article {
      gap: 1rem;
    }
  }
</style>
