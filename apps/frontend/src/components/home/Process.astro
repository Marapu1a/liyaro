---
import Container from '../ui/Container.astro';

const steps = [
  {
    title: 'Разбираемся',
    description: 'Смотрим, как процесс устроен сейчас, где возникают сложности и что нужно изменить.',
  },
  {
    title: 'Определяем решение',
    description: 'Выбираем подходящий формат и оставляем только то, что действительно нужно.',
  },
  {
    title: 'Планируем',
    description: 'Разбиваем работу на понятные этапы, определяем порядок и ожидаемый результат.',
  },
  {
    title: 'Собираем поэтапно',
    description: 'Показываем промежуточный результат и сверяемся по ходу работы.',
  },
  {
    title: 'Запускаем и дорабатываем',
    description: 'Помогаем начать работу с решением и улучшаем его с учётом реального использования.',
  },
];
---

<section id="process" class="process" aria-labelledby="process-title">
  <Container>
    <div class="section-heading">
      <p>Как работаем</p>
      <h2 id="process-title">От текущего процесса к рабочему решению</h2>
    </div>

    <ol>
      {
        steps.map((step, index) => (
          <li>
            <p class="number">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3>{step.title}</h3>
              <p class="description">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .process {
    padding-block: var(--section-space);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--section-space);
  }

  .section-heading > p,
  .number {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  li {
    display: flex;
    min-height: 21rem;
    padding: 1.5rem;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--color-border);
  }

  li:first-child {
    border-left: 1px solid var(--color-border);
  }

  h3 {
    margin-bottom: 1rem;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  @media (max-width: 64rem) {
    ol {
      grid-template-columns: 1fr 1fr;
    }

    li {
      min-height: 15rem;
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 48rem) {
    .section-heading {
      grid-template-columns: 1fr;
      margin-bottom: var(--space-lg);
    }
  }

  @media (max-width: 34rem) {
    ol {
      grid-template-columns: 1fr;
    }

    li {
      min-height: 12rem;
    }
  }
</style>
