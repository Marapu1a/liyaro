---
import Container from '../ui/Container.astro';
---

<header class="site-header" data-build-header>
  <Container>
    <div class="header-inner">
      <a class="logo" href="/" aria-label="Liyaro — главная">
        <img src="/brand/liyaro-logo.svg" alt="Liyaro" width="630" height="470" data-build-logo-target />
      </a>
      <p class="header-message">Независимая студия разработки</p>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    overflow: hidden;
    isolation: isolate;
  }

  .site-header::before,
  .site-header::after {
    position: absolute;
    z-index: -1;
    content: '';
    transform-origin: left;
  }

  .site-header::before {
    inset: 0;
    background: var(--color-surface-raised);
  }

  .site-header::after {
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
    opacity: 1;
  }

  .header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 5rem;
  }

  .logo {
    display: block;
    width: 4.7rem;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .header-message {
    position: absolute;
    top: 50%;
    right: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    opacity: 0;
    transform: translate3d(calc(100% + var(--page-padding)), -50%, 0);
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    transition:
      opacity 0.4s ease 0.28s,
      transform 0.62s var(--ease-out) 0.28s;
    will-change: transform, opacity;
  }

  .site-header:hover .header-message {
    opacity: 1;
    transform: translate3d(0, -50%, 0);
    transition-delay: 0s;
  }

  :global(html.is-building) .site-header::before,
  :global(html.is-building) .site-header::after {
    transform: scaleX(0);
  }

  :global(html.is-building) .site-header::after {
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(html.is-building) .site-header::before {
    transition: transform 0.68s var(--ease-out);
  }

  :global(html.is-building) .site-header::after {
    transition:
      transform 0.88s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.22s linear;
  }

  :global(html.is-building) .logo > img {
    opacity: 0;
  }

  :global(html.is-building) .header-message {
    opacity: 0;
    transform: translate3d(calc(100% + var(--page-padding)), -50%, 0);
  }

  :global(html.is-building) .logo > img {
    transition: opacity 0.12s linear;
  }

  :global(html.is-building) .site-header.is-fill::before,
  :global(html.is-building) .site-header.is-line::after {
    transform: scaleX(1);
  }

  :global(html.is-building) .site-header.is-line::after {
    opacity: 1;
  }

  :global(html.is-building) .site-header.is-logo .logo > img {
    opacity: 1;
  }

  @media (max-width: 30rem) {
    .header-inner {
      padding-block: 1rem;
    }

    .logo {
      width: 4.25rem;
    }

    .header-message {
      display: none;
    }

  }
</style>
