---
import Container from '../ui/Container.astro';
---

<header class="site-header">
  <Container>
    <div class="header-inner">
      <a class="logo" href="/" aria-label="Liyaro — главная">
        <img src="/brand/liyaro-logo.svg" alt="Liyaro" width="630" height="470" />
      </a>
      <nav aria-label="Основная навигация">
        <a href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects') ? 'page' : undefined}>Проекты <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    overflow: hidden;
    isolation: isolate;
  }

  .site-header::before,
  .site-header::after {
    position: absolute;
    z-index: -1;
    content: '';
    transform-origin: left;
  }

  .site-header::before {
    inset: 0;
    background: var(--color-surface-raised);
  }

  .site-header::after {
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
    opacity: 1;
  }

  .header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 5rem;
  }

  .logo {
    display: block;
    width: 4.7rem;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  nav {
    margin-left: auto;
  }

  nav a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.75rem 0;
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  nav span {
    color: var(--color-accent);
    font-size: 0.9rem;
    letter-spacing: 0;
    transition: transform 0.2s ease;
  }

  nav a:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 30rem) {
    .header-inner {
      padding-block: 1rem;
    }

    .logo {
      width: 4.25rem;
    }
  }
</style>
