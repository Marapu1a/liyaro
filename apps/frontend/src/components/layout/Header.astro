---
import Container from '../ui/Container.astro';
---

<header class="site-header" data-build-header>
  <Container>
    <div class="header-inner">
      <a class="logo" href="/" aria-label="Liyaro — главная">
        <span data-build-logo-target>LIYARO</span>
        <small>студия разработки</small>
      </a>
      <div class="header-actions">
        <button class="rebuild-button" type="button" data-build-replay>
          <span aria-hidden="true">↻</span><span class="rebuild-label">Rebuild</span>
        </button>
        <a class="contact-link" href="#contact" data-magnet>Написать о задаче <span aria-hidden="true">↘</span></a>
      </div>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    isolation: isolate;
  }

  .site-header::before,
  .site-header::after {
    position: absolute;
    z-index: -1;
    content: '';
    transform-origin: left;
  }

  .site-header::before {
    inset: 0;
    background: var(--color-surface-raised);
  }

  .site-header::after {
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
    opacity: 1;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    min-height: 5rem;
  }

  .logo {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    text-decoration: none;
  }

  .logo span {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .logo small {
    color: var(--color-text-muted);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .rebuild-button {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.4rem;
    border: 0;
    color: var(--color-text-muted);
    background: transparent;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .rebuild-button > span:first-child {
    color: var(--color-accent);
    font-size: 1rem;
    transition: transform 0.45s var(--ease-out);
  }

  .rebuild-button:hover > span:first-child {
    transform: rotate(-160deg);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-text);
    font-size: 0.94rem;
    text-decoration: none;
  }

  .contact-link span {
    margin-left: 0.6rem;
    color: var(--color-accent);
  }

  :global(html.is-building) .site-header::before,
  :global(html.is-building) .site-header::after {
    transform: scaleX(0);
  }

  :global(html.is-building) .site-header::after {
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(html.is-building) .site-header::before {
    transition: transform 0.68s var(--ease-out);
  }

  :global(html.is-building) .site-header::after {
    transition:
      transform 0.88s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.22s linear;
  }

  :global(html.is-building) .logo > span,
  :global(html.is-building) .logo small,
  :global(html.is-building) .header-actions {
    opacity: 0;
  }

  :global(html.is-building) .logo > span {
    transition: opacity 0.12s linear;
  }

  :global(html.is-building) .logo small {
    clip-path: inset(0 100% 0 0);
    transform: translateX(-0.4rem);
    transition:
      opacity 0.45s var(--ease-out),
      clip-path 0.55s var(--ease-out),
      transform 0.55s var(--ease-out);
  }

  :global(html.is-building) .header-actions {
    transform: translateX(2rem);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.65s var(--ease-out);
  }

  :global(html.is-building) .site-header.is-fill::before,
  :global(html.is-building) .site-header.is-line::after {
    transform: scaleX(1);
  }

  :global(html.is-building) .site-header.is-line::after {
    opacity: 1;
  }

  :global(html.is-building) .site-header.is-logo .logo > span,
  :global(html.is-building) .site-header.is-details .logo small,
  :global(html.is-building) .site-header.is-details .header-actions {
    opacity: 1;
  }

  :global(html.is-building) .site-header.is-details .logo small {
    clip-path: inset(0);
    transform: translateX(0);
  }

  :global(html.is-building) .site-header.is-details .header-actions {
    transform: translateX(0);
  }

  @media (max-width: 30rem) {
    .header-inner {
      padding-block: 1rem;
    }

    .contact-link {
      padding-inline: 0.75rem;
    }

    .logo small {
      display: none;
    }

    .rebuild-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
