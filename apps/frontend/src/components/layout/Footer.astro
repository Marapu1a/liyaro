---
import { siteConfig } from '../../config/site';
import Container from '../ui/Container.astro';
---

<footer>
  <Container>
    <div class="footer-inner">
      <a class="brand" href="/" aria-label={`${siteConfig.name} — главная`}>
        <img src="/brand/liyaro-logo.svg" alt="Liyaro" width="70" height="52" />
      </a>
      <nav aria-label="Юридическая информация">
        <a href="/privacy">Политика</a>
        <a href="/consent">Согласие</a>
      </nav>
      <div class="footer-contact">
        <p>© {new Date().getFullYear()}</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 1rem 2rem;
    align-items: center;
    min-height: 7rem;
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  .brand {
    display: block;
    width: 4.375rem;
    max-width: 100%;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  nav,
  .footer-contact {
    display: grid;
    gap: 0.35rem;
  }

  nav {
    grid-auto-flow: column;
    gap: 1.25rem;
  }

  a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-contact {
    justify-items: end;
  }

  @media (max-width: 40rem) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1.25rem 1rem;
      min-height: 0;
      padding-block: 1.5rem;
      align-items: end;
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      grid-auto-flow: column;
      justify-content: start;
      gap: 1.25rem;
    }

    .footer-contact {
      grid-column: 2;
      grid-row: 1;
      justify-items: end;
    }
  }
</style>
