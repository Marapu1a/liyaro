---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    id: 'makita-remont',
    number: '01',
    name: 'Каталог запчастей Makita',
    type: 'Разработка с нуля · интернет-магазин',
    lead: 'Каталог, в котором деталь можно найти по модели, артикулу и интерактивной взрыв-схеме.',
    image: '/projects/makita-remont.jpg',
    imageHeight: 900,
    imageAlt: 'Главная страница каталога запчастей makita-remont.ru с категориями товаров',
    task: 'Собрать отдельный сайт для поиска и заказа запчастей к инструменту: большой каталог моделей, схемы, детали и понятный путь к заказу.',
    work: [
      'Разработали каталог и интерфейс с нуля, включая поиск, карточки, корзину и оформление заказа.',
      'Связали детали на взрыв-схемах со списком позиций; подготовили загрузку данных и изображений.',
      'После первой версии на React перенесли публичный фронт на Astro, чтобы страницы каталога отдавались готовым HTML.',
    ],
    result: 'Рабочий публичный каталог с отдельными страницами категорий и моделей, поиском по запчастям и оформлением заказа.',
    links: [
      { label: 'Открыть сайт', href: 'https://makita-remont.ru/' },
      { label: 'Код проекта', href: 'https://github.com/Marapu1a/Makita' },
    ],
  },
  {
    id: 'makita-land',
    number: '02',
    name: 'Makita Land',
    type: 'Развитие существующего магазина · автоматизация',
    lead: 'Большой действующий магазин: приведение каталога в порядок, товарные данные и инструменты для регулярных обновлений.',
    image: '/projects/makita-land.jpg',
    imageHeight: 900,
    imageAlt: 'Главная страница интернет-магазина makita-land.ru с подборками и каталогом инструмента',
    task: 'Работать с уже купленным сайтом на Битрикс: исправить накопленные проблемы интерфейса и каталога, поддерживать актуальность товаров и наладить изображения.',
    work: [
      'Переработали фронт, карточки товаров и элементы каталога; исправили ошибки сайта и сервера.',
      'Создали Windows-программу, которая из прайсов поставщиков готовит проверенные файлы обновления цен и остатков.',
      'Выстроили процесс подбора, проверки и импорта изображений товаров; помогли с технической подготовкой сайта для SEO.',
    ],
    result: 'Магазин продолжает работать на существующей платформе, а обновление ассортимента и изображений стало повторяемой процедурой с проверками перед импортом.',
    links: [
      { label: 'Открыть сайт', href: 'https://makita-land.ru/' },
      { label: 'Работа с изображениями', href: 'https://github.com/Marapu1a/makita_images' },
    ],
  },
  {
    id: 'reestrpap',
    number: '03',
    name: 'Платформа сертификации ПАП',
    type: 'Разработка с нуля · сложная система',
    lead: 'Личный кабинет, рабочее пространство проверяющих и администратора, сертификационные циклы и публичный реестр.',
    image: '/projects/reestrpap.jpg',
    imageHeight: 460,
    imageAlt: 'Публичный реестр специалистов с поиском и фильтрами, без личных данных участников',
    task: 'Собрать единую систему для пути специалиста от регистрации и подтверждающих документов до экзамена, сертификата и публикации в реестре.',
    work: [
      'Разработали кабинеты для соискателей, проверяющих и администраторов с разными правами и задачами.',
      'Связали документы, часы практики, CEU, экзаменационные заявки и сертификаты с циклами сертификации.',
      'Создали публичный реестр с поиском, профилями и проверкой сертификатов.',
    ],
    result: 'Платформа используется для ведения сертификации, а публичный реестр позволяет находить специалистов и проверять их статус. Это длительная разработка с последующим развитием системы.',
    links: [
      { label: 'Открыть реестр', href: 'https://account.reestrpap.ru/registry' },
      { label: 'Личный кабинет', href: 'https://account.reestrpap.ru/' },
      { label: 'Код проекта', href: 'https://github.com/Marapu1a/gk_project' },
    ],
  },
  {
    id: 'qianqi',
    number: '04',
    name: 'QIANQI',
    type: 'Продукт с нуля · web3',
    lead: 'Публичный сайт, интерфейс кошелька и техническая основа проекта с токеном и будущими розыгрышами.',
    image: '/projects/qianqi.jpg',
    imageHeight: 900,
    imageAlt: 'Главная страница QIANQI с типографикой и иллюстрацией маскота',
    task: 'Превратить идею криптопродукта в понятный сайт и работающую техническую систему с проверяемыми правилами и осторожным запуском.',
    work: [
      'Разработали визуальный язык, сайт и интерфейсы подключения кошелька и просмотра состояния.',
      'Реализовали контракты, учёт покупок и подготовку механизмов розыгрышей и выплат.',
      'Настроили тестовые сценарии, проверку истории событий и отдельный путь к публикации финансовой логики.',
    ],
    result: 'Сайт и токен опубликованы. Механика розыгрышей и финансовая автоматизация проходят отдельные проверки и не представлены здесь как уже работающий публичный сервис.',
    links: [
      { label: 'Открыть сайт', href: 'https://qianqi.site/' },
      { label: 'Код проекта', href: 'https://github.com/Marapu1a/rh_project' },
    ],
  },
] as const;
---

<BaseLayout
  title="Проекты Liyaro — сайты, магазины и сложные системы"
  description="Реализованные проекты Liyaro: каталог запчастей Makita, развитие Makita Land, платформа сертификации ПАП и QIANQI. Задачи, работа и результаты."
  canonicalPath="/projects/"
>
  <Header />
  <main>
    <section class="projects-intro" aria-labelledby="projects-title">
      <Container>
        <p class="eyebrow">03 / Реализованные проекты</p>
        <h1 id="projects-title">Работа, которую<br />можно открыть.</h1>
        <p class="intro-lead">Четыре разных проекта: от каталога запчастей до платформы сертификации и продукта на блокчейне. Показываем, какие задачи решали, что сделали и что работает сейчас.</p>
        <nav class="project-index" aria-label="Проекты на странице">
          {projects.map((project) => <a href={`#${project.id}`}><span>{project.number}</span>{project.name}</a>)}
        </nav>
      </Container>
    </section>

    <Container>
      {projects.map((project) => (
        <article class="project" id={project.id} aria-labelledby={`${project.id}-title`}>
          <div class="project-topline"><span>{project.number} / 04</span><span>{project.type}</span></div>
          <div class="project-heading">
            <h2 id={`${project.id}-title`}>{project.name}</h2>
            <p>{project.lead}</p>
          </div>
          <figure class="project-image">
            <img src={project.image} alt={project.imageAlt} width="1440" height={project.imageHeight} loading="lazy" decoding="async" />
            <figcaption>Скриншот публичного сайта · октябрь 2026</figcaption>
          </figure>
          <div class="project-details">
            <div class="detail"><h3>Задача</h3><p>{project.task}</p></div>
            <div class="detail"><h3>Что сделали</h3><ul>{project.work.map((item) => <li>{item}</li>)}</ul></div>
            <div class="detail result"><h3>Результат</h3><p>{project.result}</p></div>
          </div>
          <div class="project-links">
            {project.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}
          </div>
        </article>
      ))}
      <div class="page-end"><p>Есть задача похожего масштаба?</p><a href="/#contact">Расскажите о ней <span aria-hidden="true">↗</span></a></div>
    </Container>
  </main>
  <Footer />
</BaseLayout>

<style>
  .projects-intro { padding: clamp(4rem, 8vw, 8rem) 0 clamp(3rem, 7vw, 6rem); }
  .eyebrow, .project-topline, .detail h3, figcaption { color: var(--color-text-muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .76rem; font-weight: 650; letter-spacing: .09em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 2rem; }
  h1 { max-width: 16ch; margin: 0; }
  .intro-lead { max-width: 46rem; margin: 2rem 0 3rem; color: var(--color-text-muted); font-size: clamp(1.12rem, 1.6vw, 1.45rem); line-height: 1.5; }
  .project-index { display: flex; flex-wrap: wrap; gap: .7rem; }
  .project-index a { display: inline-flex; gap: .75rem; align-items: center; padding: .8rem 1rem; color: var(--color-text); text-decoration: none; border: 1px solid var(--color-border); }
  .project-index a:hover { border-color: var(--color-text); }
  .project-index span { color: var(--color-accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .8rem; }
  .project { padding: clamp(3rem, 7vw, 6rem) 0; border-top: 1px solid var(--color-border); scroll-margin-top: 1rem; }
  .project-topline { display: flex; justify-content: space-between; gap: 1rem; }
  .project-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(16rem, .8fr); align-items: end; gap: 2rem; margin: 2.2rem 0; }
  .project-heading h2 { max-width: 18ch; margin: 0; color: var(--color-text); }
  .project-heading p { max-width: 34rem; margin: 0; color: var(--color-text-muted); font-size: clamp(1.08rem, 1.5vw, 1.3rem); line-height: 1.5; }
  .project-image { margin: 0; }
  .project-image img { display: block; width: 100%; height: auto; max-height: 47rem; object-fit: cover; object-position: top; border: 1px solid var(--color-border); }
  figcaption { margin-top: .8rem; font-size: .68rem; }
  .project-details { display: grid; grid-template-columns: 1fr 1.4fr 1fr; gap: clamp(1.5rem, 3vw, 3rem); margin-top: clamp(2rem, 5vw, 4rem); }
  .detail h3 { margin: 0 0 1rem; color: var(--color-accent); }
  .detail p, .detail ul { margin: 0; line-height: 1.6; }
  .detail ul { padding-left: 1.1rem; }
  .detail li + li { margin-top: .7rem; }
  .result { padding-left: clamp(1.5rem, 3vw, 3rem); border-left: 1px solid var(--color-border); }
  .project-links { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.5rem; }
  .project-links a, .page-end a { display: inline-flex; gap: 1rem; align-items: center; justify-content: space-between; padding: .8rem 1rem; color: var(--color-text); font-weight: 600; text-decoration: none; border: 1px solid var(--color-border); }
  .project-links a:hover, .page-end a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .page-end { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 2.5rem 0 5rem; border-top: 1px solid var(--color-border); }
  .page-end p { margin: 0; font-size: clamp(1.4rem, 2.5vw, 2.2rem); font-weight: 550; }
  @media (max-width: 52rem) { .project-heading { grid-template-columns: 1fr; gap: 1rem; } .project-details { grid-template-columns: 1fr 1fr; } .result { grid-column: 1 / -1; padding: 1.5rem 0 0; border-top: 1px solid var(--color-border); border-left: 0; } }
  @media (max-width: 38rem) { .projects-intro { padding-top: 3rem; } h1 { font-size: clamp(2.7rem, 10vw, 4rem); } .project-topline { display: block; line-height: 1.8; } .project-topline span + span { display: block; } .project-details { grid-template-columns: 1fr; } .result { grid-column: auto; } .project-links a { width: 100%; } .page-end { display: block; } .page-end a { margin-top: 1.2rem; } }
</style>
