---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import ContactForm from '../components/home/ContactForm.astro';
import Hero from '../components/home/Hero.astro';
import Situations from '../components/home/Situations.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Liyaro — разработка сайтов, сервисов и внутренних систем';
const description =
  'Разрабатываем сайты и интернет-магазины, внутренние системы, автоматизацию, ботов и приложения. Помогаем разобраться в задаче и довести проект до запуска.';
---

<BaseLayout {title} {description} canonicalPath="/">
  <Header />
  <main>
    <Hero />
    <Situations />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
