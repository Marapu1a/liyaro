---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import BuildIntro from '../components/layout/BuildIntro.astro';
import ContactForm from '../components/home/ContactForm.astro';
import Hero from '../components/home/Hero.astro';
import Situations from '../components/home/Situations.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Liyaro — разработка сайтов, сервисов и внутренних систем';
const description =
  'Расскажите о задаче своими словами. Поможем разобраться, что стоит сделать и нужна ли для этого разработка.';
---

<BaseLayout {title} {description} canonicalPath="/" buildIntro>
  <BuildIntro />
  <Header />
  <main>
    <Hero />
    <Situations />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
