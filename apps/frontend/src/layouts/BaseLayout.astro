---
import '../styles/global.css';

import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  buildIntro?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  buildIntro = false,
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL('/og-image.png', siteUrl);
const logoUrl = new URL('/brand/liyaro-logo.svg', siteUrl);
const yandexVerification = import.meta.env.YANDEX_SITE_VERIFICATION?.trim();
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: siteConfig.name,
      inLanguage: 'ru-RU',
      publisher: { '@id': `${siteUrl.href}#operator` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl.href}#operator`,
      name: siteConfig.legalName,
      url: siteUrl.href,
      email: `mailto:${siteConfig.email}`,
      brand: {
        '@type': 'Brand',
        name: siteConfig.name,
        logo: logoUrl.href,
      },
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Liyaro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Liyaro — сайты, сервисы и внутренние системы" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Liyaro — сайты, сервисы и внутренние системы" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline define:vars={{ buildIntro }}>
      const introSessionKey = 'liyaro:intro:seen';
      let shouldPlayIntro = buildIntro;

      if (shouldPlayIntro) {
        try {
          shouldPlayIntro = window.sessionStorage.getItem(introSessionKey) !== 'true';
          if (shouldPlayIntro) window.sessionStorage.setItem(introSessionKey, 'true');
        } catch {
          // The intro still works when storage is unavailable.
        }
      }

      if ('scrollRestoration' in window.history) {
        window.history.scrollRestoration = 'manual';
      }
      if (shouldPlayIntro) {
        window.scrollTo(0, 0);
        window.addEventListener('pageshow', () => window.scrollTo(0, 0), { once: true });
      }
      document.documentElement.classList.add('has-js');
      if (shouldPlayIntro) {
        document.documentElement.classList.add('build-intro-pending');
        window.setTimeout(() => document.documentElement.classList.remove('build-intro-pending'), 5000);
      }
      window.__LIYARO_SHOULD_PLAY_INTRO__ = shouldPlayIntro;
    </script>
  </head>
  <body data-build-intro={buildIntro ? 'true' : 'false'}>
    <slot />
    <script>
      import { initInteractions } from '../scripts/interactions';

      if (
        document.body.dataset.buildIntro === 'true' &&
        window.__LIYARO_SHOULD_PLAY_INTRO__ === true
      ) {
        const { initBuildSequence } = await import('../scripts/buildSequence');
        initBuildSequence();
      }
      initInteractions();
    </script>
  </body>
</html>
