generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactMethod {
  TELEGRAM @map("telegram")
  WHATSAPP @map("whatsapp")
  EMAIL    @map("email")
  PHONE    @map("phone")
}

model Inquiry {
  id             String        @id @default(cuid())
  message        String        @db.Text
  contactMethod  ContactMethod @map("contact_method")
  contact        String
  name           String?
  consentGivenAt DateTime      @default(now()) @map("consent_given_at") @db.Timestamptz(3)
  consentVersion String        @map("consent_version")
  consentFormId  String        @map("consent_form_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("inquiries")
}
